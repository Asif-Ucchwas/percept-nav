<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>percept_nav_costmap_plugin</name>
  <version>0.0.0</version>
  <description>Custom Nav2 costmap layer plugin that fuses camera-based obstacle detections into the costmap, part of the Percept-Nav perception pipeline</description>
  <maintainer email="asifuzzamanucchwas@gmail.com">jannatul</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>pluginlib</depend>
  <depend>vision_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>rclcpp_lifecycle</test_depend>
  <test_depend>tf2_ros</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <nav2_costmap_2d plugin="${prefix}/detection_layer_plugin.xml" />
  </export>
</package>
